{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.user-monitoring.local/v1/batch.schema.json",
  "title": "Batch",
  "description": "Body of POST /v1/batch. One request carries at most 500 events or 1 MB compressed; the size limit is enforced by the server, not by this schema. The envelope is closed: no key other than sent_at and batch.",
  "type": "object",
  "required": ["sent_at", "batch"],
  "additionalProperties": false,
  "properties": {
    "sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "Device clock at the moment the batch was sent, with offset. The server computes clock skew as received_at minus sent_at and applies it to every event timestamp in the batch when it exceeds 5 seconds."
    },
    "batch": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": { "$ref": "#/$defs/event" }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "Lowercase UUID of any version. The nil UUID is allowed where the field says so."
    },
    "uuidv7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "Lowercase UUIDv7: version nibble 7, RFC 9562 variant, Unix milliseconds in the first 48 bits."
    },
    "uint32": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "reserved_name": {
      "enum": ["$app_installed", "$app_updated", "$app_backgrounded", "$app_foregrounded", "$tap", "$events_dropped"],
      "description": "The closed list of names an SDK emits on its own. A host app cannot use any name starting with $."
    },
    "event": {
      "type": "object",
      "required": ["event_id", "type", "device_id", "session_id", "seq", "timestamp", "context"],
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "$ref": "#/$defs/uuidv7",
          "description": "UUIDv7 minted on the client. Time-ordered and the deduplication key. Never reused."
        },
        "type": {
          "enum": ["screen", "screen_exit", "track", "identify", "session_start", "session_end"]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "anyOf": [{ "pattern": "^[^$]" }, { "$ref": "#/$defs/reserved_name" }],
          "description": "Event name, only on track events. A host app name never starts with $; names starting with $ are the reserved list."
        },
        "device_id": {
          "$ref": "#/$defs/uuid",
          "description": "Random UUID minted on first run and persisted. Never a hardware or advertising id. Server SDKs forward the client's id from X-Device-Id or use one they minted themselves."
        },
        "user_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Present on every event after identify(); absent before it and after reset(). Server SDKs set it directly."
        },
        "session_id": {
          "$ref": "#/$defs/uuid",
          "description": "Random UUID minted by the client when a session starts. The nil UUID means no client session, used only by server SDKs."
        },
        "seq": {
          "$ref": "#/$defs/uint32",
          "description": "Per-session counter starting at 0 and incremented for every event, lifecycle events included. Ordering never depends on the clock. Server-side events always carry 0."
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "Device clock at capture, with offset."
        },
        "screen": { "$ref": "#/$defs/screen" },
        "element": { "$ref": "#/$defs/element" },
        "traits": { "$ref": "#/$defs/properties" },
        "properties": { "$ref": "#/$defs/properties" },
        "launch_type": {
          "enum": ["cold", "warm", "resume"],
          "description": "cold: process start or page load with no live session. warm: new session while the app is in the foreground (reset()). resume: foreground after the session timeout."
        },
        "duration_ms": { "$ref": "#/$defs/uint32", "description": "Session length on session_end: last activity minus session_start." },
        "screens_viewed": { "$ref": "#/$defs/uint32", "description": "Number of screen events in the session." },
        "events_count": { "$ref": "#/$defs/uint32", "description": "Number of events in the session including session_end itself, so it equals the session_end seq plus one." },
        "context": { "$ref": "#/$defs/context" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "screen" } } },
          "then": {
            "required": ["screen"],
            "properties": {
              "screen": { "type": "object", "properties": { "duration_ms": false } },
              "name": false,
              "element": false,
              "traits": false,
              "launch_type": false,
              "duration_ms": false,
              "screens_viewed": false,
              "events_count": false
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "screen_exit" } } },
          "then": {
            "required": ["screen"],
            "properties": {
              "screen": { "type": "object", "required": ["duration_ms"], "properties": { "previous": false, "previous_duration_ms": false } },
              "name": false,
              "element": false,
              "traits": false,
              "properties": false,
              "launch_type": false,
              "duration_ms": false,
              "screens_viewed": false,
              "events_count": false
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "track" } } },
          "then": {
            "required": ["name"],
            "properties": {
              "screen": false,
              "traits": false,
              "launch_type": false,
              "duration_ms": false,
              "screens_viewed": false,
              "events_count": false
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "identify" } } },
          "then": {
            "required": ["user_id"],
            "properties": {
              "name": false,
              "screen": false,
              "element": false,
              "properties": false,
              "launch_type": false,
              "duration_ms": false,
              "screens_viewed": false,
              "events_count": false
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "session_start" } } },
          "then": {
            "required": ["launch_type"],
            "properties": {
              "name": false,
              "screen": false,
              "element": false,
              "traits": false,
              "properties": false,
              "duration_ms": false,
              "screens_viewed": false,
              "events_count": false
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "session_end" } } },
          "then": {
            "required": ["duration_ms", "screens_viewed", "events_count"],
            "properties": {
              "name": false,
              "screen": false,
              "element": false,
              "traits": false,
              "properties": false,
              "launch_type": false
            }
          }
        },
        {
          "if": { "required": ["name"], "properties": { "name": { "const": "$tap" } } },
          "then": { "required": ["element"] }
        },
        {
          "if": { "required": ["name"], "properties": { "name": { "const": "$events_dropped" } } },
          "then": {
            "required": ["properties"],
            "properties": {
              "properties": {
                "type": "object",
                "required": ["count"],
                "properties": { "count": { "type": "integer", "minimum": 1 } }
              }
            }
          }
        }
      ]
    },
    "screen": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "dependentRequired": {
        "previous": ["previous_duration_ms"],
        "previous_duration_ms": ["previous"]
      },
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "previous": { "type": "string", "minLength": 1, "maxLength": 128, "description": "Screen shown before this one. Absent on the first screen of a session and after a denylisted screen." },
        "previous_duration_ms": { "$ref": "#/$defs/uint32", "description": "Visible dwell on the previous screen. Present exactly when previous is, on screen events only." },
        "duration_ms": { "$ref": "#/$defs/uint32", "description": "Visible dwell on this screen. Only on screen_exit events, where it is required." },
        "route": { "type": "string", "maxLength": 512, "description": "Route or path when the platform has one (web, Compose navigation)." }
      }
    },
    "element": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [{ "required": ["id"] }, { "required": ["label"] }],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "description": "Resource id name, accessibilityIdentifier or data-monitor-id." },
        "label": { "type": "string", "minLength": 1, "maxLength": 64, "description": "Accessibility label or visible button text, truncated to 64 characters. Never the contents of a text field." },
        "type": { "type": "string", "maxLength": 32, "description": "Control type: the view class, UIKit class or HTML tag name." },
        "screen": { "type": "string", "maxLength": 128, "description": "Screen the element was tapped on." }
      }
    },
    "properties": {
      "type": "object",
      "maxProperties": 100,
      "propertyNames": { "minLength": 1, "maxLength": 64 },
      "additionalProperties": {
        "type": ["string", "number", "boolean", "null"],
        "maxLength": 1024
      },
      "description": "Flat map of scalar values. At most 100 keys, 64-character keys, 1 KB per string value. The server also caps the whole event at 32 KB."
    },
    "context": {
      "type": "object",
      "required": ["platform", "app", "os", "sdk", "locale", "timezone"],
      "additionalProperties": false,
      "properties": {
        "platform": {
          "enum": ["android", "ios", "web", "desktop", "server"],
          "description": "Where the event was captured. The js SDK reports web in a browser and desktop under Electron."
        },
        "app": {
          "type": "object",
          "required": ["name", "version"],
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "minLength": 1, "maxLength": 128 },
            "version": { "type": "string", "minLength": 1, "maxLength": 32 },
            "build": { "type": "string", "maxLength": 32 },
            "bundle_id": { "type": "string", "minLength": 1, "maxLength": 256, "description": "Bundle id, package name or web origin, checked against the project's allowlist. Required on every platform except server." }
          }
        },
        "os": {
          "type": "object",
          "required": ["name", "version"],
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "minLength": 1, "maxLength": 32 },
            "version": { "type": "string", "minLength": 1, "maxLength": 32 }
          }
        },
        "device": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "model": { "type": "string", "maxLength": 64 },
            "manufacturer": { "type": "string", "maxLength": 64 },
            "screen": { "type": "string", "pattern": "^[0-9]{1,5}x[0-9]{1,5}$", "description": "Width x height in points, for example 393x852." }
          }
        },
        "browser": {
          "type": "object",
          "required": ["name", "version"],
          "additionalProperties": false,
          "description": "Sent by the js SDK only.",
          "properties": {
            "name": { "type": "string", "minLength": 1, "maxLength": 32 },
            "version": { "type": "string", "minLength": 1, "maxLength": 32 }
          }
        },
        "locale": { "type": "string", "minLength": 1, "maxLength": 16, "description": "BCP 47 language tag, for example en-GB." },
        "timezone": { "type": "string", "minLength": 1, "maxLength": 64, "description": "IANA time zone name, for example Europe/London." },
        "network": { "enum": ["wifi", "cellular", "ethernet", "offline", "unknown"] },
        "sdk": {
          "type": "object",
          "required": ["name", "version", "spec"],
          "additionalProperties": false,
          "properties": {
            "name": { "enum": ["kotlin", "swift", "js", "php"] },
            "version": { "type": "string", "minLength": 1, "maxLength": 32 },
            "spec": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$",
              "description": "The sdk-spec VERSION the SDK was built against."
            }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "platform": { "enum": ["android", "ios", "web", "desktop"] } } },
          "then": { "properties": { "app": { "type": "object", "required": ["bundle_id"] } } }
        }
      ]
    }
  }
}
