{
  "spec_version": "1.0.0-draft.4",
  "id": "offline-then-online",
  "platforms": ["kotlin", "swift", "js"],
  "description": "Events captured without a network are delivered in order after reconnect, none lost, none duplicated. The 30-event trigger fires while offline and fails, and its retries back off. Going online ends that network-failure wait (protocol.md section 4), so the queue drains in one batch, whether the end of the wait or the explicit flush sends it.",
  "steps": [
    { "action": "launch" },
    { "action": "network", "state": "offline" },
    { "action": "track", "name": "button_tap", "repeat": 50 },
    { "action": "wait_ms", "value": 20000 },
    { "action": "network", "state": "online" },
    { "action": "flush" },
    { "action": "assert_requests", "count": 1 }
  ],
  "expect": {
    "requests": { "min": 1, "max": 1 },
    "events": [
      { "type": "session_start", "launch_type": "cold", "user_id": { "$absent": true }, "$session": "s1" },
      { "type": "track", "name": "$app_installed", "$session": "s1" },
      { "type": "track", "name": "button_tap", "$repeat": 50, "$session": "s1" }
    ],
    "checks": ["event_ids_unique", "seq_contiguous_per_session", "device_id_constant"]
  }
}
