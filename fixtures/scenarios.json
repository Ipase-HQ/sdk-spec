{
  "spec_version": "1.0.0-draft.2",
  "scenarios": [
    {
      "id": "offline-then-online",
      "platforms": ["kotlin", "swift", "js"],
      "description": "Events captured without a network are delivered in order after reconnect, none lost, none duplicated.",
      "steps": [
        { "action": "network", "state": "offline" },
        { "action": "track", "name": "button_tap", "repeat": 50 },
        { "action": "wait_ms", "value": 20000 },
        { "action": "network", "state": "online" },
        { "action": "flush" }
      ],
      "expect": { "events_total": 50, "events_unique": 50, "ordered_by_seq": true, "requests_min": 1 }
    },
    {
      "id": "process-kill",
      "platforms": ["kotlin", "swift"],
      "description": "Events persisted before a kill arrive on the next launch, and the dead session's session_end is emitted and backdated.",
      "steps": [
        { "action": "launch", "launch_type": "cold" },
        { "action": "screen", "name": "Feed" },
        { "action": "track", "name": "like", "repeat": 5 },
        { "action": "kill_process" },
        { "action": "wait_ms", "value": 400000 },
        { "action": "launch", "launch_type": "cold" },
        { "action": "flush" }
      ],
      "expect": { "events_total": 9, "session_end_count": 1, "session_end_backdated_to_last_activity": true, "session_start_count": 2 }
    },
    {
      "id": "backoff-429",
      "platforms": ["kotlin", "swift", "js", "php"],
      "description": "A 429 with Retry-After 30 produces no retry for 30 seconds and keeps the queue intact.",
      "server": { "respond": [ { "status": 429, "retry_after": 30 }, { "status": 202 } ] },
      "steps": [
        { "action": "track", "name": "button_tap", "repeat": 3 },
        { "action": "flush" },
        { "action": "wait_ms", "value": 15000 },
        { "action": "flush" },
        { "action": "wait_ms", "value": 20000 },
        { "action": "flush" }
      ],
      "expect": { "requests_total": 2, "min_gap_between_requests_ms": 30000, "events_total": 3, "events_unique": 3 }
    },
    {
      "id": "session-timeout",
      "platforms": ["kotlin", "swift", "js"],
      "description": "Background for the timeout plus one second starts a new session on foreground; one second less does not.",
      "config": { "session_timeout_seconds": 300 },
      "steps": [
        { "action": "launch", "launch_type": "cold" },
        { "action": "background" },
        { "action": "wait_ms", "value": 299000 },
        { "action": "foreground" },
        { "action": "background" },
        { "action": "wait_ms", "value": 301000 },
        { "action": "foreground" },
        { "action": "flush" }
      ],
      "expect": { "session_start_count": 2, "session_end_count": 1, "foregrounded_count": 1, "launch_types": ["cold", "warm"] }
    },
    {
      "id": "identity-stitching",
      "platforms": ["kotlin", "swift", "js"],
      "description": "Events before identify carry only device_id, events after carry both, and reset clears user_id and rotates the session.",
      "steps": [
        { "action": "launch", "launch_type": "cold" },
        { "action": "track", "name": "browse" },
        { "action": "identify", "user_id": "u_123", "traits": { "plan": "free" } },
        { "action": "track", "name": "purchase" },
        { "action": "reset" },
        { "action": "track", "name": "browse" },
        { "action": "flush" }
      ],
      "expect": { "user_id_absent_before_identify": true, "user_id_present_after_identify": true, "device_id_constant": true, "session_count": 2 }
    },
    {
      "id": "privacy",
      "platforms": ["kotlin", "swift", "js"],
      "description": "Typed text never appears in any payload; denylisted screens produce no events.",
      "config": { "denylist_screens": ["Payment"] },
      "steps": [
        { "action": "launch", "launch_type": "cold" },
        { "action": "screen", "name": "Login" },
        { "action": "type_text", "field": "password", "value": "hunter2-secret" },
        { "action": "tap", "element_id": "login_button", "label": "Sign in" },
        { "action": "screen", "name": "Payment" },
        { "action": "tap", "element_id": "pay_button", "label": "Pay now" },
        { "action": "flush" }
      ],
      "expect": { "payload_never_contains": ["hunter2-secret"], "screens_seen": ["Login"], "elements_seen": ["login_button"] }
    },
    {
      "id": "property-limits",
      "platforms": ["kotlin", "swift", "js", "php"],
      "description": "An event with 101 property keys is rejected locally with a logged warning and never sent.",
      "steps": [
        { "action": "track", "name": "too_many", "property_count": 101 },
        { "action": "track", "name": "fine", "property_count": 100 },
        { "action": "flush" }
      ],
      "expect": { "events_total": 1, "event_names": ["fine"], "warning_logged": true }
    }
  ]
}
